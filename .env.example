# ───────────── Database (PostgreSQL) ─────────────
DATABASE_URL=postgresql://massefelt:massefelt@localhost:5432/massefelt
# Used by `pnpm test:integration` (a separate, disposable database)
TEST_DATABASE_URL=postgresql://massefelt:massefelt@localhost:5432/massefelt_test

# ───────────── Auth ─────────────
# dev      = single local user, provisioned automatically (development only)
# supabase = planned production mode (not implemented yet; fails closed)
AUTH_MODE=dev
DEV_USER_EMAIL=dev@massefelt.local

# ───────────── Object storage ─────────────
# local = filesystem (default), s3 = any S3-compatible store (AWS, MinIO, R2)
STORAGE_DRIVER=local
# Absolute path recommended; relative paths resolve from the process working directory.
STORAGE_LOCAL_ROOT=./.data/storage
S3_BUCKET=massefelt
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=massefelt
S3_SECRET_ACCESS_KEY=massefelt-secret
S3_FORCE_PATH_STYLE=true

# ───────────── Uploads ─────────────
UPLOAD_MAX_BYTES=104857600
UPLOAD_MAX_POINTS=10000000

# ───────────── AI providers (server-side only, never exposed to the browser) ─────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# default = server-side refusal fallback routing; off = disabled
ANTHROPIC_FALLBACKS=default
AI_MAX_TOOL_ROUNDS=8
AI_MAX_MESSAGE_CHARS=8000

# ───────────── Worker (Python) ─────────────
WORKER_ID=worker-local
WORKER_POLL_INTERVAL_SECONDS=2
# Photogrammetry engine adapter: "none" (default) – see docs/photogrammetry-pipeline.md
PHOTOGRAMMETRY_ENGINE=none

LOG_LEVEL=info
