{
  "name": "massefelt",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Construction-site 3D scanning, point-cloud processing, terrain analysis and AI-assisted workflows.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @massefelt/web dev",
    "build": "pnpm --filter @massefelt/web build",
    "start": "pnpm --filter @massefelt/web start",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:worker": "cd apps/worker && $( [ -x .venv/bin/python ] && echo .venv/bin/python || echo python3 ) -m pytest -q",
    "db:generate": "pnpm --filter @massefelt/database generate",
    "db:migrate": "pnpm --filter @massefelt/database migrate:deploy",
    "db:migrate:dev": "pnpm --filter @massefelt/database migrate:dev",
    "mcp": "pnpm --filter @massefelt/mcp start",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test:e2e": "playwright test",
    "worker": "cd apps/worker && $( [ -x .venv/bin/python ] && echo .venv/bin/python || echo python3 ) -m massefelt_worker"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
